      "item": [
        {
          "id": "838cde50-5810-4e5f-919f-69ea49ec1dfe",
          "name": "JFrog Artifactory Promote Docker Image",
          "request": {
            "name": "JFrog Artifactory Promote Docker Image",
            "description": {
              "content": "Artifactory-specific extension to promote a Docker image from one repository to another. This is useful for promoting images through staging environments (e.g., dev to staging to production).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "docker",
                ":repoKey",
                "v2",
                "promote"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "repoKey",
                  "description": "(Required) Source repository key"
                },
                {
                  "description": "Your JFrog Platform deployment URL",
                  "type": "any",
                  "value": "{{server}}",
                  "key": "server"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetRepo\": \"<string>\",\n  \"dockerRepository\": \"<string>\",\n  \"targetDockerRepository\": \"<string>\",\n  \"tag\": \"<string>\",\n  \"targetTag\": \"<string>\",\n  \"copy\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
