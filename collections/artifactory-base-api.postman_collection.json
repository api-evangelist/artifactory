            },
            "url": {
              "path": [
                "v2",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "Your JFrog Platform deployment URL",
                  "type": "any",
                  "value": "{{server}}",
                  "key": "server"
                }
              ]
            },
            "method": "GET",
            "auth": null
