                {
                  "disabled": false,
                  "key": "otherNumber",
                  "value": "<string>",
                  "description": "(Required) The other build number to compare against"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "buildName",
                  "description": "(Required) The name of the build"
