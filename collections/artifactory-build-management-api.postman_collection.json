        {
          "id": "f6a02295-33e3-46b7-ac50-3587cee1a16a",
          "name": "Delete Build",
          "request": {
            "name": "Delete Build",
            "description": {
              "content": "Deletes a build and all its runs. Optionally deletes the associated build artifacts.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "build",
                ":buildName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "deleteAll",
                  "value": "1",
                  "description": "If 1, delete all build numbers. If 0, requires buildNumbers param."
                },
                {
                  "disabled": false,
                  "key": "buildNumbers",
                  "value": "<string>",
                  "description": "Comma-separated list of build numbers to delete"
                },
                {
                  "disabled": false,
                  "key": "artifacts",
                  "value": "0",
                  "description": "If 1, also delete associated build artifacts from repositories"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "buildName",
                  "description": "(Required) The name of the build"
                },
                {
                  "description": "Your JFrog Platform deployment URL",
                  "type": "any",
                  "value": "{{server}}",
                  "key": "server"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE",
            "auth": null
          },
