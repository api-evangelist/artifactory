      "name": "Build Promotion",
      "description": {
        "content": "Promote builds between repositories",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ebf6123d-5ee5-49e7-8c5f-0c1e71f797b4",
          "name": "Promote Build",
          "request": {
            "name": "Promote Build",
            "description": {
              "content": "Promotes a build by moving or copying the build artifacts and dependencies from a source repository to a target repository. Used to promote builds through staging environments (e.g., from staging to production).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "build",
                "promote",
                ":buildName",
                ":buildNumber"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "buildName",
                  "description": "(Required) The name of the build"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "buildNumber",
                  "description": "(Required) The build number (version)"
                },
                {
                  "description": "Your JFrog Platform deployment URL",
                  "type": "any",
                  "value": "{{server}}",
                  "key": "server"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetRepo\": \"<string>\",\n  \"status\": \"<string>\",\n  \"comment\": \"<string>\",\n  \"ciUser\": \"<string>\",\n  \"timestamp\": \"<dateTime>\",\n  \"properties\": {\n    \"key_0\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  },\n  \"sourceRepo\": \"<string>\",\n  \"copy\": false,\n  \"artifacts\": true,\n  \"dependencies\": false,\n  \"failFast\": true,\n  \"dryRun\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
