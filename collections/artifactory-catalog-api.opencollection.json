{
  "opencollection": "1.0.0",
  "info": {
    "name": "JFrog Artifactory Query Language (AQL) AQL Search Catalog API",
    "version": "7.x"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Catalog",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "JFrog Artifactory List Repositories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{server}/artifactory/v2/_catalog",
            "params": [
              {
                "name": "n",
                "value": "",
                "type": "query",
                "description": "Maximum number of entries to return"
              },
              {
                "name": "last",
                "value": "",
                "type": "query",
                "description": "Last repository name for pagination"
              }
            ]
          },
          "docs": "Returns a list of repositories available in the registry."
        }
      ]
    }
  ],
  "bundled": true
}