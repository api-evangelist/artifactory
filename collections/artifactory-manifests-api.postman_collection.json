          "request": {
            "name": "JFrog Artifactory Get Image Manifest",
            "description": {
              "content": "Retrieves the manifest for an image identified by name and reference (tag or digest). The Accept header determines the manifest format returned.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                ":name",
                "manifests",
                ":reference"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "name",
                  "description": "(Required) Docker image name, which may include multiple path components (e.g., library/nginx or myproject/myimage)"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "reference",
                  "description": "(Required) Image tag or digest reference"
                },
                {
                  "description": "Your JFrog Platform deployment URL",
                  "type": "any",
                  "value": "{{server}}",
                  "key": "server"
                }
